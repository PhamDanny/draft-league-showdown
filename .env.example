# Copy to .env and fill in.
PORT=8000
# The address people use to reach the site, without a trailing slash.
PUBLIC_URL=http://localhost:8000

DISCORD_CLIENT_ID=1570124523754229833
DISCORD_CLIENT_SECRET=

# Your Discord user id. This account becomes server admin and can create leagues.
ADMIN_DISCORD_IDS=

# Lets you sign in as made-up players to test drafts and battles alone. Never turn on for real use.
DEV_LOGIN=0

# Discord bot (draft board, on-the-clock pings, weekly recaps, slash commands). See "Discord bot" in README.md.
# Bot tab of the same Discord application used for sign-in. Leave empty to run without the bot.
DISCORD_BOT_TOKEN=
# General Information tab, "Public Key". Needed for slash commands.
DISCORD_PUBLIC_KEY=
