# Copy to .env and fill in.
PORT=8000
# The address people use to reach the site, without a trailing slash.
PUBLIC_URL=http://localhost:8000

DISCORD_CLIENT_ID=1570124523754229833
DISCORD_CLIENT_SECRET=

# Your Discord user id. This account becomes server admin and can create leagues.
ADMIN_DISCORD_IDS=

# Lets you sign in as made-up players to test drafts and battles alone. Never turn on for real use.
DEV_LOGIN=0
